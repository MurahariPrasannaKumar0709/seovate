# Shared secret the Next.js frontend sends as `Authorization: Bearer <value>` — must match
# LIGHTHOUSE_SERVICE_SECRET in frontend/.env.local (and the frontend's Vercel env vars in prod).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LIGHTHOUSE_SERVICE_SECRET=

# Optional — Render sets $PORT automatically in production; only needed for local runs.
PORT=4000
