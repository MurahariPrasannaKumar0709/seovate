NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database (Postgres via docker-compose.yml at the repo root — `docker compose up -d`)
DATABASE_URL=postgresql://seovate:seovate_dev_password@localhost:5435/seovate

# Auth
SESSION_SECRET=change-me
OTP_PEPPER=change-me-otp-pepper

# Encrypts OAuth tokens (integrations) at rest — 32-byte key, base64. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google Sign-In (login/signup "Continue with Google") — obtain from
# https://console.cloud.google.com/apis/credentials (OAuth client ID, Web application).
# Register GOOGLE_LOGIN_REDIRECT_URI and GOOGLE_INTEGRATIONS_REDIRECT_URI below as authorized
# redirect URIs on the same OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Real account connections for Search Console / Analytics / Business Profile (Settings >
# Integrations, and onboarding). Reuses GOOGLE_CLIENT_ID/SECRET above — just needs this redirect
# URI additionally registered on that same OAuth client.
GOOGLE_INTEGRATIONS_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# GitHub OAuth App (Settings > Integrations "GitHub") — create one at
# https://github.com/settings/developers, authorization callback URL = GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback

# SMTP — leave unset in development to auto-use a disposable Ethereal test inbox
# (signup/forgot-password responses include a previewUrl to view the sent email).
# Set all four to send through a real mail provider instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seovate <reports@seovate.com>"

# Authorizes /api/cron/* (GSC sitemap monitoring + weekly report emails). In production, set this
# same value as a Vercel project env var — Vercel Cron then sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. Locally, call the routes yourself with this header to test.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Used to build links back into the app from monitoring/report emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standalone Lighthouse audit service (see lighthouse-service/README.md) — separate Node deploy,
# not the FastAPI backend. LIGHTHOUSE_SERVICE_SECRET must match that service's own env var.
LIGHTHOUSE_SERVICE_URL=http://localhost:4000
LIGHTHOUSE_SERVICE_SECRET=
