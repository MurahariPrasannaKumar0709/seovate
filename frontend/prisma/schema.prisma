generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?
  googleSub    String?
  integrations Integration[]
  technicalSeoScans TechnicalSeoScan[]

  @@map("users")
}

// Deliberately has no FK relation to User: a signup OTP is requested (and stored) before
// any User row exists — the User is only created once the code is verified.
model OtpCode {
  id              String   @id @default(cuid())
  email           String
  purpose         String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  sentAt          DateTime
  resendCount     Int      @default(1)
  windowStartedAt DateTime

  @@unique([email, purpose])
  @@map("otp_codes")
}

model Integration {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  status           String    @default("connected")
  accessTokenEnc   String
  refreshTokenEnc  String?
  scope            String?
  externalLabel    String?
  tokenExpiresAt   DateTime?
  // GitHub-only: the repo the user picked to scaffold SEO files into, the site URL to audit
  // when generating them, and the number of the last PR Seovate opened for that scaffolding.
  repoFullName     String?
  siteUrl          String?
  lastPrNumber     Int?
  // Google Search Console monitoring: whether to email this user about sitemap issues/weekly
  // reports, the last time a monitoring check ran, a JSON snapshot of sitemap path -> {errors,
  // warnings} from that check (used to only email on new/changed issues, not every run), and the
  // last time a weekly report email went out (so an hourly cron doesn't resend it).
  notifyByEmail      Boolean   @default(true)
  lastSitemapCheckAt DateTime?
  lastSitemapIssues  String?
  lastReportSentAt   DateTime?
  connectedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("integrations")
}

// A single run of the technical-SEO crawler + rule engine (docs/13-seo-automation-plan.md's V1
// rule list) against one site. `pagesScanned`/`truncated` record the crawl's actual reach so the
// UI can say "audited 40 of ~120 pages" instead of implying full-site coverage.
model TechnicalSeoScan {
  id           String    @id @default(cuid())
  userId       String
  siteUrl      String
  status       String    @default("running") // running | complete | failed
  pagesScanned Int       @default(0)
  truncated    Boolean   @default(false)
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  // Set once a "fix missing canonical tags" PR has been opened for this scan (see
  // /api/technical-seo/fix) — repo is captured alongside the PR number since the user's selected
  // repo could change between the scan and any later merge/close action on this PR.
  fixPrNumber       Int?
  fixPrRepoFullName String?
  findings     TechnicalSeoFinding[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("technical_seo_scans")
}

model TechnicalSeoFinding {
  id        String           @id @default(cuid())
  scanId    String
  ruleId    String
  category  String
  severity  String
  url       String
  evidence  Json
  createdAt DateTime         @default(now())
  scan      TechnicalSeoScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("technical_seo_findings")
}
